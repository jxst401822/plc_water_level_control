# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Machine Expert / SoMachine (IDE 生成文件) ----
# 用户锁文件与预编译缓存:随开关 IDE 变化,可再生
*.~u
*.precompilecache
*.compileinfo
*.project.saved
# 下载/编译时生成的控制器 bootinfo(带 Application GUID,每次构建可再生)
*.bootinfo
*.bootinfo_guids
# 用户/机器相关的 IDE 选项文件(每台机器一份,勿入库;工程本体是 .project)
*.opt

# ---- 运行输出 ----
output/

# ---- 打包产物 ----
*.zip

# ---- 本地配置(含 PLC IP 等现场信息) ----
.water-control/
config.local.json

# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
